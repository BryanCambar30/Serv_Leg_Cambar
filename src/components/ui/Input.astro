---
type InputType =
  | "text"
  | "number"
  | "email"
  | "password"
  | "search"
  | "tel"
  | "url"
  | "date"
  | "datetime-local"
  | "month"
  | "time"
  | "week"
  | "color"
  | "checkbox"
  | "radio"
  | "file"
  | "hidden"
  | "image"
  | "range"
  | "reset"
  | "submit"
  | "button";

export interface Props {
  type?: InputType;
  placeholder?: string;
  label?: string;
  class?: string;
}
const { type = 'text', placeholder, class: className } = Astro.props;
---

<input 
  type={type} 
  placeholder={placeholder} 
  class={`w-full bg-white border border-gray-30 rounded-sm
  px-4 py-2 text-neutral placeholder:text-gray-400 
  focus:border-secondary focus:outline-none transition-colors ${className}`}
/>