---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={`flex items-center justify-center w-full max-w-[60%] mx-auto my-4 ${className}`}>
  <div class="flex-1 h-px bg-secondary/70"></div>
  <div class="w-1.5 h-1.5 bg-secondary transform rotate-45 mx-2"></div>
  <div class="flex-1 h-px bg-secondary/70"></div>
</div>