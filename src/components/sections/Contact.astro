---
import Button from '../ui/Button.astro';
import Input from '../ui/Input.astro';
---

<section id="contacto" class="relative pt-16 pb-8 bg-navy text-white overflow-hidden">
  <div class="relative z-20 container mx-auto px-4 max-w-4xl text-center">
    <h2 class="font-serif text-3xl font-bold text-secondary mb-8 uppercase tracking-wider">CONTÁCTENOS</h2>

    <!-- Formulario con inputs blancos cuadrados -->
    <form class="grid grid-cols-1 md:grid-cols-2 gap-4 text-left mb-8">
      <Input placeholder="Nombre" />
      <Input placeholder="Correo Electrónico" />
      <Input placeholder="Teléfono" />
      <Input placeholder="Asunto" />
      
      <div class="md:col-span-2">
        <textarea placeholder="Mensaje" class="w-full bg-white border border-gray-300 rounded-sm px-4 py-2.5 h-24 text-neutral placeholder:text-gray-400 focus:border-secondary focus:outline-none transition-colors shadow-sm resize-none"></textarea>
      </div>
    </form>

    <button class="bg-secondary text-white px-14 py-2 rounded-full font-sans text-sm font-bold shadow-lg hover:brightness-110 transition-all uppercase tracking-wide mb-12">
      Enviar
    </button>
  </div>

