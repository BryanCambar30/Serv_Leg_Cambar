  <!-- 🟢 MENÚ DESPLEGABLE MÓVIL 🟢 -->
  <div id="mobile-menu" class="hidden absolute top-full left-0 w-full bg-navy/95 backdrop-blur-md border-b border-gold/30 py-6 px-gutter flex-col gap-4 shadow-xl md:hidden">
    <a class="text-white hover:text-gold transition-colors font-title-sm text-sm uppercase tracking-widest text-center py-2" href="#inicio">Inicio</a>
