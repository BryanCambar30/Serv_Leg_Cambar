<script>
  // --- Lógica del Navbar (Scroll y Menú Móvil) ---
  const nav = document.getElementById('main-nav');
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  // 1. Efecto de Scroll (Cambia de transparente a azul con blur)
  window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
          nav.classList.add('bg-navy/80', 'backdrop-blur-md', 'py-4', 'shadow-lg');
          nav.classList.remove('py-6');
      } else {
          nav.classList.remove('bg-navy/80', 'backdrop-blur-md', 'py-4', 'shadow-lg');
          nav.classList.add('py-6');
      }
  });

  // 2. Toggle del Menú Hamburguesa (Abrir / Cerrar)
  menuBtn.addEventListener('click', () => {
      const isHidden = mobileMenu.classList.contains('hidden');
      if (isHidden) {
          mobileMenu.classList.remove('hidden');
          mobileMenu.classList.add('flex');
          // Cambia el icono a "cerrar"
          menuBtn.innerHTML = `<span class="material-symbols-outlined text-3xl">close</span>`;
      } else {
          mobileMenu.classList.add('hidden');
          mobileMenu.classList.remove('flex');
          // Vuelve a poner el icono de "menú"
          menuBtn.innerHTML = `<span class="material-symbols-outlined text-3xl">menu</span>`;
      }
  });

  // 3. Cerrar el menú automáticamente cuando el usuario hace clic en un enlace
  document.querySelectorAll('#mobile-menu a').forEach(link => {
      link.addEventListener('click', () => {
          mobileMenu.classList.add('hidden');
          mobileMenu.classList.remove('flex');
          menuBtn.innerHTML = `<span class="material-symbols-outlined text-3xl">menu</span>`;
      });
  });
</script>